{
  "$defs": {
    "ActionAnchor": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "title": "Anchor",
          "type": "number"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "anchor",
        "lower",
        "upper",
        "rationale",
        "evidence"
      ],
      "title": "ActionAnchor",
      "type": "object"
    },
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "material",
            "state",
            "action",
            "profile_assignment",
            "evidence",
            "review",
            "rubric"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "public": {
          "title": "Public",
          "type": "boolean"
        },
        "content": {
          "additionalProperties": true,
          "title": "Content",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "sha256",
        "available_at",
        "public",
        "content"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rps-assessment/1.2",
          "default": "rps-assessment/1.2",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "material": {
          "$ref": "#/$defs/Reference"
        },
        "state": {
          "$ref": "#/$defs/Reference"
        },
        "action": {
          "$ref": "#/$defs/Reference"
        },
        "profile_assignment": {
          "$ref": "#/$defs/Reference"
        },
        "formula": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Formula",
          "type": "string"
        },
        "family": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "state_summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "State Summary",
          "type": "string"
        },
        "action_summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Action Summary",
          "type": "string"
        },
        "role": {
          "enum": [
            "new_candidate",
            "conditional_candidate",
            "mechanism_anchor",
            "reference_anchor",
            "benchmark_control",
            "negative_control"
          ],
          "title": "Role",
          "type": "string"
        },
        "target_fit": {
          "enum": [
            "matches",
            "approved_conversion",
            "mismatch",
            "unresolved"
          ],
          "title": "Target Fit",
          "type": "string"
        },
        "problem_resolved": {
          "default": false,
          "title": "Problem Resolved",
          "type": "boolean"
        },
        "dimensions": {
          "additionalProperties": {
            "$ref": "#/$defs/Dimension"
          },
          "title": "Dimensions",
          "type": "object"
        },
        "decision_impact": {
          "$ref": "#/$defs/ActionAnchor"
        },
        "discrimination": {
          "$ref": "#/$defs/ActionAnchor"
        },
        "readiness": {
          "$ref": "#/$defs/ActionAnchor"
        },
        "outcomes": {
          "items": {
            "$ref": "#/$defs/Outcome"
          },
          "maxItems": 10,
          "minItems": 2,
          "title": "Outcomes",
          "type": "array"
        },
        "costs": {
          "items": {
            "$ref": "#/$defs/Cost"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Costs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "revision",
        "material",
        "state",
        "action",
        "profile_assignment",
        "formula",
        "family",
        "state_summary",
        "action_summary",
        "role",
        "target_fit",
        "dimensions",
        "decision_impact",
        "discrimination",
        "readiness",
        "outcomes",
        "costs"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "Campaign": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Version",
          "type": "string"
        },
        "objective": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "target_pressure_max_gpa": {
          "minimum": 0,
          "title": "Target Pressure Max Gpa",
          "type": "number"
        },
        "budget": {
          "additionalProperties": {
            "minimum": 0,
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "cpu_core_hours",
              "gpu_hours",
              "memory_gib",
              "storage_gib",
              "human_hours"
            ]
          },
          "title": "Budget",
          "type": "object"
        },
        "profile_mixes": {
          "patternProperties": {
            "^[A-Za-z0-9_.:-]+$": {
              "additionalProperties": {
                "minimum": 0,
                "type": "number"
              },
              "type": "object"
            }
          },
          "propertyNames": {
            "maxLength": 120,
            "minLength": 1
          },
          "title": "Profile Mixes",
          "type": "object"
        },
        "dimension_rules": {
          "additionalProperties": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Dimension Rules",
          "type": "object"
        }
      },
      "required": [
        "id",
        "version",
        "objective",
        "target_pressure_max_gpa",
        "budget",
        "profile_mixes",
        "dimension_rules"
      ],
      "title": "Campaign",
      "type": "object"
    },
    "Cost": {
      "additionalProperties": false,
      "properties": {
        "resource": {
          "enum": [
            "cpu_core_hours",
            "gpu_hours",
            "memory_gib",
            "storage_gib",
            "human_hours"
          ],
          "title": "Resource",
          "type": "string"
        },
        "lower": {
          "minimum": 0,
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upper"
        },
        "basis": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "resource",
        "lower",
        "upper",
        "basis",
        "evidence"
      ],
      "title": "Cost",
      "type": "object"
    },
    "Dimension": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "assessed",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "anchor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Anchor"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        },
        "rule_id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Rule Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 100,
          "title": "Evidence",
          "type": "array"
        },
        "missing_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        }
      },
      "required": [
        "status",
        "anchor",
        "lower",
        "upper",
        "rule_id",
        "rationale"
      ],
      "title": "Dimension",
      "type": "object"
    },
    "Outcome": {
      "additionalProperties": false,
      "properties": {
        "observation": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Observation",
          "type": "string"
        },
        "decision": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Decision",
          "type": "string"
        }
      },
      "required": [
        "observation",
        "decision"
      ],
      "title": "Outcome",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "Reference",
      "type": "object"
    },
    "ReviewedAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessment": {
          "$ref": "#/$defs/Assessment"
        },
        "review": {
          "$ref": "#/$defs/Reference"
        }
      },
      "required": [
        "assessment",
        "review"
      ],
      "title": "ReviewedAssessment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rps-release/1.2",
      "default": "rps-release/1.2",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Id",
      "type": "string"
    },
    "policy_version": {
      "const": "RPS-v1.2",
      "title": "Policy Version",
      "type": "string"
    },
    "policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "campaign": {
      "$ref": "#/$defs/Campaign"
    },
    "campaign_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Campaign Hash",
      "type": "string"
    },
    "evidence_cutoff": {
      "format": "date-time",
      "title": "Evidence Cutoff",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "maxItems": 100000,
      "title": "Artifacts",
      "type": "array"
    },
    "assessments": {
      "items": {
        "$ref": "#/$defs/ReviewedAssessment"
      },
      "maxItems": 10000,
      "title": "Assessments",
      "type": "array"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    }
  },
  "required": [
    "id",
    "policy_version",
    "policy_hash",
    "campaign",
    "campaign_hash",
    "evidence_cutoff",
    "published_at",
    "artifacts",
    "assessments",
    "manifest_sha256"
  ],
  "title": "PriorityRelease",
  "type": "object"
}
