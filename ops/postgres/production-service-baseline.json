{
  "source_revision": "984d5d96f7bc5a8727fab20579e4016f740bef42",
  "scope": "Uninterpolated approved PostgreSQL service; no credential values",
  "service": {
    "image": "postgres:16-alpine",
    "container_name": "sclib-postgres",
    "restart": "unless-stopped",
    "environment": {
      "POSTGRES_DB": "sclib",
      "POSTGRES_USER": "sclib",
      "POSTGRES_PASSWORD": "${DB_PASSWORD}"
    },
    "volumes": [
      "postgres_data:/var/lib/postgresql/data"
    ],
    "healthcheck": {
      "test": [
        "CMD-SHELL",
        "pg_isready -U sclib -d sclib"
      ],
      "interval": "5s",
      "timeout": "3s",
      "retries": 10
    }
  }
}
