# SCLib_JZIS environment variables — copy to .env and fill in.
# Values marked REQUIRED must be set before `docker compose up`.

# === Database ===
DB_PASSWORD=CHANGE_ME_STRONG_RANDOM                # REQUIRED
DATABASE_URL=postgresql://sclib:CHANGE_ME_STRONG_RANDOM@postgres:5432/sclib

# === Redis ===
REDIS_URL=redis://redis:6379

# === GCP ===
GCP_PROJECT=jzis-sclib
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/credentials/gcp-api.json
VERTEX_AI_INDEX_ENDPOINT=                          # REQUIRED after Phase 0 step 6
VERTEX_AI_DEPLOYED_INDEX_ID=sclib_papers_v1
GCS_BUCKET=sclib-jzis

# === Disaster recovery ===
# Must be a separate bucket/failure domain from GCS_BUCKET. Configure bucket
# retention/versioning and grant only the dedicated backup identity access.
SCLIB_BACKUP_BUCKET=sclib-jzis-backups
SCLIB_BACKUP_PREFIX=postgres
SCLIB_BACKUP_RETAIN_DAYS=35
SCLIB_BACKUP_CREDENTIALS_FILE=/etc/sclib/credentials/backup-external-account.json
SCLIB_BACKUP_SERVICE_ACCOUNT=sclib-backup@jzis-sclib.iam.gserviceaccount.com

# === AI Models ===
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LOCATION=global
GEMINI_USE_ENTERPRISE=true
GEMINI_API_VERSION=v1
VECTOR_SEARCH_TIMEOUT_SECONDS=12
GEMINI_TIMEOUT_SECONDS=30
PROVIDER_MAX_ATTEMPTS=2
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=60
CLIENT_TELEMETRY_PER_MINUTE=120
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=0.1
# Required before enabling the optional observability Compose profile.
GRAFANA_ADMIN_PASSWORD=replace_with_a_long_random_password
EMBEDDING_MODEL=text-embedding-005
EMBEDDING_OUTPUT_DIMENSIONALITY=768

# === Auth ===
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM                # REQUIRED
JWT_EXPIRY_HOURS=24
API_KEY_PREFIX=scl_

# Auth endpoint abuse controls (IP + normalized account identifier)
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_REGISTER_WINDOW_SECONDS=3600
AUTH_REGISTER_IP_LIMIT=10
AUTH_REGISTER_ACCOUNT_LIMIT=3
AUTH_RESET_WINDOW_SECONDS=3600
AUTH_RESET_IP_LIMIT=10
AUTH_RESET_ACCOUNT_LIMIT=3
AUTH_BACKOFF_BASE_SECONDS=2
AUTH_BACKOFF_ACCOUNT_THRESHOLD=3
AUTH_BACKOFF_IP_THRESHOLD=5
AUTH_BACKOFF_MAX_SECONDS=300
PASSWORD_RESET_EXPIRY_MINUTES=30

# === Email (Resend) ===
RESEND_API_KEY=re_xxxxxxxxxxxx                     # REQUIRED
EMAIL_FROM="SCLib <noreply@jzis.org>"

# === App ===
FRONTEND_URL=https://jzis.org/sclib
API_BASE_URL=https://api.jzis.org/sclib/v1
GUEST_DAILY_LIMIT=3
ENVIRONMENT=production
SCLIB_DISCOVERY_FEED_PATH=/data/sclib/discovery/discovery_feed.json
SCLIB_DISCOVERY_DIR=/data/sclib/discovery
# Derived Timeline rows refresh in the background; set 0 to disable safely
# and keep the legacy JSONB read path active.
SCLIB_TIMELINE_PROJECTION_INTERVAL_SEC=900

# === Internal admin hooks ===
# Shared secret for internal-only endpoints (e.g. POST /stats/refresh
# called by scripts/cron_daily_ingest.sh). Never expose via Nginx.
INTERNAL_API_KEY=CHANGE_ME_INTERNAL_CRON_KEY       # REQUIRED for nightly cron
