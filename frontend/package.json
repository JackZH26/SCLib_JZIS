{
  "name": "sclib-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "pnpm test:source && pnpm test:unit",
    "test:source": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:browser-auth": "node --test tests/browser-session-auth.test.mjs",
    "test:public-urls": "node --test tests/public-auth-links.test.mjs",
    "test:security-headers": "node --test tests/security-headers.test.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "katex": "^0.18.0",
    "next": "16.2.10",
    "plotly.js": "3.7.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "react-plotly.js": "4.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/typography": "0.5.15",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-plotly.js": "2.6.3",
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "10.4.19",
    "jsdom": "29.1.1",
    "postcss": "8.5.18",
    "tailwindcss": "3.4.3",
    "typescript": "5.4.3",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.18"
    }
  }
}
