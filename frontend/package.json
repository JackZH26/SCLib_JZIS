{
  "name": "sclib-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "pnpm test:source && pnpm test:unit",
    "test:source": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:browser-auth": "node --test tests/browser-session-auth.test.mjs",
    "test:public-urls": "node --test tests/public-auth-links.test.mjs",
    "test:security-headers": "node --test tests/security-headers.test.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "katex": "^0.16.45",
    "next": "15.5.21",
    "plotly.js": "2.35.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "9.0.1",
    "react-plotly.js": "2.6.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-plotly.js": "2.6.3",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "10.5.4",
    "jsdom": "30.0.1",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.4",
      "postcss": "8.5.26",
      "sharp": "0.35.0"
    }
  }
}
